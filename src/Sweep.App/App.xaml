<Application x:Class="Sweep.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Sweep.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 索引 0 必须是主题令牌字典：ThemeService 运行时替换它即可整站换肤。
                 索引 1 是与主题无关的结构样式，始终保留。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 展示层转换器直接挂在应用级：所有窗口共享同一实例 -->
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:PercentToArcConverter x:Key="PercentToArc"/>
            <conv:ByteSizeConverter x:Key="ByteSize"/>
            <conv:PercentOfMaxConverter x:Key="PercentOfMax"/>
            <conv:CategoryDimensionConverter x:Key="CategoryDimension"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
