<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：中性石板灰表面 + 单一强调蓝，靠「表面分层 + 1px 发丝边框」建立层级，
         不靠重阴影。主文本 #12181F 对 #FFFFFF ≈ 17:1，次文本 #5A6573 ≈ 6.6:1。
         所有 x:Key 必须与 Tokens.Dark.xaml 完全一致（ThemeArchitectureTests 守护）。 -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="BgBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#DDE2E9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE6"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2563EB"/>

    <SolidColorBrush x:Key="TextBrush" Color="#12181F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6573"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#687382"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FE"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="LowBrush" Color="#0F9D74"/>
    <SolidColorBrush x:Key="LowSoftBrush" Color="#E2F6EE"/>
    <SolidColorBrush x:Key="LowTextBrush" Color="#0A6B4F"/>
    <SolidColorBrush x:Key="MediumBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="MediumSoftBrush" Color="#FDF2DE"/>
    <SolidColorBrush x:Key="MediumTextBrush" Color="#8A4A06"/>
    <SolidColorBrush x:Key="HighBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="HighSoftBrush" Color="#FDECDF"/>
    <SolidColorBrush x:Key="HighTextBrush" Color="#9A3412"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#BE123C"/>
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#FCE4EA"/>
    <SolidColorBrush x:Key="CriticalTextBrush" Color="#9F1239"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0273A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBE7E9"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A31528"/>
    <SolidColorBrush x:Key="OnRiskBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C8D0DA"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6B2C0"/>
    <SolidColorBrush x:Key="RingTrackBrush" Color="#E6EAF0"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#12181F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#12181F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E9ECF1"/>

    <DropShadowEffect x:Key="CardShadow" Color="#64748B" Opacity="0.13"
                      BlurRadius="16" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="PopupShadow" Color="#64748B" Opacity="0.22"
                      BlurRadius="22" ShadowDepth="6" Direction="270"/>
</ResourceDictionary>
