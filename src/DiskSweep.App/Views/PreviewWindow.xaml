<Window x:Class="DiskSweep.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理前预览清单" Width="980" Height="680" MinWidth="820" MinHeight="560"
        Background="{DynamicResource BgBrush}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel>
                <TextBlock Text="清理前预览" Style="{StaticResource TitleText}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Text="逐项核对路径、体积与依据。默认全部移入回收站，可从系统回收站还原。"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="12,5" VerticalAlignment="Top"
                    Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="{Binding Rows.Count, StringFormat={}本次共 {0} 项}" FontSize="11.5"
                           Foreground="{DynamicResource AccentTextBrush}"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,4,6,8">
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                    <DataGridTemplateColumn Header="体积" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Size}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource DisplayFont}" FontSize="12.5"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="风险" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Risk}" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="依据 / 后果" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,14,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource MediumBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Permanent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <CheckBox Content="启用永久删除（不可撤销 · 禁用所有 AI 建议）"
                              Foreground="{DynamicResource DangerBrush}"
                              IsChecked="{Binding Permanent, Mode=TwoWay}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="确认词" VerticalAlignment="Center" Width="72"
                                   Style="{StaticResource MutedText}"/>
                        <TextBox Width="220" IsEnabled="{Binding ConfirmEnabled}"
                                 Text="{Binding ConfirmWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="请输入「永久删除」四个字"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding HintText}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" FontSize="11.5"
                               Foreground="{DynamicResource HighBrush}" Text="{Binding ConsequencesText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       Text="确认后开始执行；失败项会逐条列出原因，不会静默跳过。"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                        MinWidth="104" Margin="0,0,10,0"/>
                <Button Content="{Binding ConfirmCaption}" Command="{Binding ConfirmCommand}" MinWidth="140" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
